# --- Rust Build Artifacts ---
# Contains all compiled binaries, libraries, and temporary build files
/target/

# --- Backup and Temporary Files ---
# Backup files generated automatically by rustfmt
**/*.rs.bk

# Rustc internal compiler error stack dumps
rustc-ice-*.txt

# --- Windows/MSVC Specific ---
# Debugging information files generated by MSVC Windows builds
*.pdb